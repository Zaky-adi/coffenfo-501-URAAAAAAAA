        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{register_email}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "{{base_url}}/api/v1/auth/forgot-password", "host": [ "{{base_url}}" ], "path": [ "api", "v1", "auth", "forgot-password" ] }
      }
    },
    {
      "name": "Auth / Reset password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Password reset succeeds', () => pm.response.to.have.status(200));",
