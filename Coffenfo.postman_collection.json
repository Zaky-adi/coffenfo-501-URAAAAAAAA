    {
      "name": "Master / Read areas",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Public master list is cacheable', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('ETag')).to.be.a('string'); pm.expect(pm.response.headers.get('Cache-Control')).to.include('max-age=3600'); pm.expect(pm.response.json().success).to.eql(true); });"
      ] } }],
      "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/json" }], "url": { "raw": "{{base_url}}/api/v1/master/areas", "host": [ "{{base_url}}" ], "path": [ "api", "v1", "master", "areas" ] } }
    },
    {
      "name": "Master / Read other lists (duplicate and run per path)",
